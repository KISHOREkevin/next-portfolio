import fs from "node:fs";

const pkgPath = "node_modules/@iconify-icons/ph/package.json";
const pkg = JSON.parse(fs.readFileSync(pkgPath, "utf8"));
const keys = new Set(Object.keys(pkg.exports));

const wanted = [
  "user-circle", "code", "briefcase", "stack", "terminal-window",
  "folder-open", "file-text", "envelope-simple", "gear-six", "squares-four",
  "compass", "sun", "moon", "magnifying-glass", "app-window", "minus",
  "corners-out", "corners-in", "x", "caret-left", "arrows-clockwise",
  "image", "camera", "check", "info", "desktop", "hard-drive", "palette",
  "identification-card", "user", "folder", "archive", "terminal", "cpu",
  "monitor", "sparkle", "warning-circle", "list", "dots-three", "caret-down"
];

const lines = [`EXPORT COUNT: ${keys.size}`, ""];
for (const name of wanted) {
  lines.push(`${name}: ${keys.has("./" + name) ? "YES" : "NO"}`);
}

lines.push("", "--- resolution check for chosen set ---");
const resolve = (n) => {
  const e = pkg.exports["./" + n];
  return e ? e.default : "MISSING";
};
lines.push(resolve("user-circle"));
lines.push(resolve("terminal-window"));
lines.push(resolve("gear-six"));

fs.writeFileSync("ph-names.txt", lines.join("\n"), "utf8");
console.log("ok");
